<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style x:Key="RoundedEntry"
           TargetType="Entry">

        <Setter Property="HeightRequest"
                Value="52"/>

        <Setter Property="BackgroundColor"
                Value="White"/>

    </Style>

    <Style x:Key="RoundedPicker"
           TargetType="Picker">

        <Setter Property="HeightRequest"
                Value="52"/>

        <Setter Property="BackgroundColor"
                Value="White"/>

    </Style>

    <Style x:Key="RoundedEditor"
           TargetType="Editor">

        <Setter Property="BackgroundColor"
                Value="White"/>

        <Setter Property="AutoSize"
                Value="TextChanges"/>

    </Style>

</ResourceDictionary>