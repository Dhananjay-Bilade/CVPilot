<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CVPilot.Views.Resume"
    x:Class="CVPilot.Views.Resume.MyResumePage"
    Title="My Resumes"
    BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#121212}">

    <ContentPage.Resources>
        <local:PercentageToProgressConverter
            x:Key="PercentageToProgressConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            Padding="20,20,20,10"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="3">

                <Label
                    Text="My Resumes"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#111827, Dark=White}" />

                <Label
                    Text="Manage and organize your resumes"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />

            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="+ New"
                Clicked="CreateNewResume_Clicked"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="10"
                Padding="16,8"
                FontAttributes="Bold"
                VerticalOptions="Center" />

        </Grid>

        <!-- Resume List -->
        <CollectionView
            x:Name="ResumeCollectionView"
            Grid.Row="1"
            Margin="20,10,20,20"
            SelectionMode="None">

            <!-- Empty State -->
            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    Spacing="12"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="📄"
                        FontSize="55"
                        HorizontalOptions="Center" />

                    <Label
                        Text="No resumes yet"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="{AppThemeBinding Light=#111827, Dark=White}" />

                    <Label
                        Text="Create your first resume and start building your career."
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />

                    <Button
                        Text="Create New Resume"
                        Clicked="CreateNewResume_Clicked"
                        BackgroundColor="#0F766E"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="20,12"
                        Margin="0,10,0,0"
                        FontAttributes="Bold" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,14"
                        Padding="16"
                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#333333}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="13">

                            <!-- Resume Information -->
                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="4">

                                    <Label
                                        Text="{Binding ResumeName}"
                                        FontSize="19"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        TextColor="{AppThemeBinding Light=#111827, Dark=White}" />

                                    <Label
                                        Text="{Binding ResumeCategory}"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#2563EB" />

                                    <Label
                                        Text="{Binding UpdatedOn, StringFormat='Last modified: {0:dd MMM yyyy, hh:mm tt}'}"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />

                                </VerticalStackLayout>

                                <!-- Completion -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    Spacing="2">

                                    <Label
                                        Text="{Binding CompletionPercentage, StringFormat='{0}%'}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        HorizontalOptions="Center"
                                        TextColor="#0F766E" />

                                    <Label
                                        Text="Complete"
                                        FontSize="10"
                                        HorizontalOptions="Center"
                                        TextColor="{AppThemeBinding Light=#6B7280, Dark=#AAAAAA}" />

                                </VerticalStackLayout>

                            </Grid>

                            <!-- Real Progress -->
                            <ProgressBar
                                Progress="{Binding CompletionPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                ProgressColor="#0F766E"
                                BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#333333}"
                                HeightRequest="6" />

                            <!-- Action Buttons -->
                            <Grid
                                ColumnDefinitions="*,*,*,*"
                                ColumnSpacing="6">

                                <Button
                                    Grid.Column="0"
                                    Text="Preview"
                                    Clicked="Preview_Clicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    Padding="4,8"
                                    BackgroundColor="#EEF2FF"
                                    TextColor="#3730A3"
                                    CornerRadius="8" />

                                <Button
                                    Grid.Column="1"
                                    Text="Edit"
                                    Clicked="Edit_Clicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    Padding="4,8"
                                    BackgroundColor="#ECFEFF"
                                    TextColor="#0E7490"
                                    CornerRadius="8" />

                                <Button
                                    Grid.Column="2"
                                    Text="Export"
                                    Clicked="Export_Clicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    Padding="4,8"
                                    BackgroundColor="#ECFDF5"
                                    TextColor="#047857"
                                    CornerRadius="8" />

                                <Button
                                    Grid.Column="3"
                                    Text="Delete"
                                    Clicked="Delete_Clicked"
                                    CommandParameter="{Binding .}"
                                    FontSize="12"
                                    Padding="4,8"
                                    BackgroundColor="#FEF2F2"
                                    TextColor="#B91C1C"
                                    CornerRadius="8" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>