<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CVPilot.Views.Sections.EducationPage"
    Title="Education"
    BackgroundColor="#F6F8FC">

    <Grid>

        <CollectionView
            x:Name="EducationCollection"
            Margin="16"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,18"
                        Padding="18"
                        Background="#FFFFFF"
                        Stroke="#E8ECF4"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="14">

                            <!-- Degree -->
                            <Label
                                Text="{Binding Degree}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#1E40AF" />

                            <!-- Divider -->
                            <BoxView
                                HeightRequest="1"
                                BackgroundColor="#E5E7EB" />

                            <!-- Field -->
                            <HorizontalStackLayout Spacing="8">

                                <Label
                                    Text="💻"
                                    FontSize="16"/>

                                <Label
                                    Text="{Binding FieldOfStudy}"
                                    FontSize="16"
                                    TextColor="#2563EB"/>

                            </HorizontalStackLayout>

                            <!-- Institute -->
                            <HorizontalStackLayout Spacing="8">

                                <Label Text="🏫"/>

                                <Label
                                    Text="{Binding Institute}"
                                    FontAttributes="Bold"
                                    FontSize="15"/>

                            </HorizontalStackLayout>

                            <!-- University -->
                            <HorizontalStackLayout Spacing="8">

                                <Label Text="🎓"/>

                                <Label
                                    Text="{Binding University}"
                                    FontSize="14"
                                    TextColor="Gray"/>

                            </HorizontalStackLayout>

                            <!-- Duration -->
                            <HorizontalStackLayout Spacing="8">

                                <Label Text="📅"/>

                                <Label
                                    Text="{Binding Duration}"
                                    FontSize="14"/>

                            </HorizontalStackLayout>

                            <!-- Grade -->
                            <HorizontalStackLayout Spacing="8">

                                <Label Text="⭐"/>

                                <Label
                                    Text="{Binding Grade,StringFormat='CGPA : {0}'}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="#D97706"/>

                            </HorizontalStackLayout>

                            <!-- Description -->
                            <Border
                                Padding="10"
                                Background="#F8FAFC"
                                StrokeThickness="0"
                                IsVisible="{Binding Description}">

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="13"
                                    TextColor="#475569"/>

                            </Border>

                            <!-- Buttons -->
                            <Grid
                                Margin="0,12,0,0"
                                ColumnDefinitions="*,16,*">

                                <Button
                                    Grid.Column="0"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    BackgroundColor="#2563EB"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="✏ Edit"
                                    TextColor="White"
                                    Clicked="Edit_Clicked"
                                    CommandParameter="{Binding Id}" />

                                <Button
                                    Grid.Column="2"
                                    HeightRequest="48"
                                    CornerRadius="12"
                                    BackgroundColor="#DC2626"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    Text="🗑 Delete"
                                    TextColor="White"
                                    Clicked="Delete_Clicked"
                                    CommandParameter="{Binding Id}" />

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="12">

                    <Label
                        FontSize="72"
                        HorizontalOptions="Center"
                        Text="🎓"/>

                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalOptions="Center"
                        Text="No Education Added"/>

                    <Label
                        FontSize="15"
                        HorizontalTextAlignment="Center"
                        Text="Tap the + button below to add your education."
                        TextColor="Gray"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

        <!-- Floating Button -->

        <Button
            WidthRequest="68"
            HeightRequest="68"
            Margin="24"
            HorizontalOptions="End"
            VerticalOptions="End"
            BackgroundColor="#2563EB"
            CornerRadius="34"
            FontSize="32"
            FontAttributes="Bold"
            Shadow="{OnPlatform Default={x:Null}}"
            Text="+"
            TextColor="White"
            Clicked="AddEducation_Clicked"/>

    </Grid>

</ContentPage>
