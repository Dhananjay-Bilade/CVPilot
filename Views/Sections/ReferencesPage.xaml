<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CVPilot.Views.Sections.ReferencesPage"
    Title="References"
    BackgroundColor="#F6F8FC">

    <Grid>

        <CollectionView
            x:Name="ReferencesCollection"
            Margin="15">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="18"
                        Margin="0,0,0,15"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Background="White"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding FullName}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#1E3A8A"/>

                            <Label
                                Text="{Binding Designation}"
                                FontSize="16"
                                TextColor="#2563EB"/>

                            <Label
                                Text="{Binding CompanyName}"
                                TextColor="Gray"/>

                            <Label
                                Text="{Binding Email}"
                                FontSize="13"
                                TextColor="Gray"/>

                            <Label
                                Text="{Binding PhoneNumber}"
                                FontSize="13"
                                TextColor="Gray"/>

                            <Label
                                Text="{Binding Relationship}"
                                FontSize="13"
                                FontAttributes="Italic"
                                TextColor="#666"/>

                            <Grid
                                Margin="0,10,0,0"
                                ColumnDefinitions="*,20,*">

                                <Button
                                    Grid.Column="0"
                                    Text="✏ Edit"
                                    Clicked="Edit_Clicked"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    CornerRadius="12"/>

                                <Button
                                    Grid.Column="2"
                                    Text="🗑 Delete"
                                    Clicked="Delete_Clicked"
                                    CommandParameter="{Binding Id}"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    CornerRadius="12"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="👥"
                        FontSize="72"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="No References Added"
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Tap + to add your first reference."
                        TextColor="Gray"
                        HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

        <Button
            Text="+"
            WidthRequest="65"
            HeightRequest="65"
            CornerRadius="33"
            FontSize="30"
            BackgroundColor="#2563EB"
            TextColor="White"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="25"
            Clicked="AddReference_Clicked"/>

    </Grid>

</ContentPage>