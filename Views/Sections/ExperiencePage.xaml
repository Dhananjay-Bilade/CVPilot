<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CVPilot.Views.Sections.ExperiencePage"
    Title="Experience"
    BackgroundColor="#F6F8FC">

    <Grid>

        <CollectionView
            x:Name="ExperienceCollection"
            Margin="15">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Background="#FFFFFF"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="18"
                        Margin="0,0,0,15">

                        <VerticalStackLayout Spacing="10">

                            <!-- Job Title -->
                            <Label
                                Text="{Binding JobTitle}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#1E3A8A"/>

                            <!-- Company -->
                            <Label
                                Text="{Binding CompanyName}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#2563EB"/>

                            <BoxView
                                HeightRequest="1"
                                Color="#ECECEC"/>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="📍"/>
                                <Label Text="{Binding Location}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="💼"/>
                                <Label Text="{Binding EmploymentType}"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="📅"/>
                                <Label Text="{Binding Duration}"/>
                            </HorizontalStackLayout>

                            <Label
                                Text="{Binding Description}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                TextColor="Gray"/>

                            <Grid
                                Margin="0,12,0,0"
                                ColumnDefinitions="*,20,*">

                                <Button
                                    Grid.Column="0"
                                    Text="✏ Edit"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    HeightRequest="45"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    Clicked="Edit_Clicked"
                                    CommandParameter="{Binding Id}"/>

                                <Button
                                    Grid.Column="2"
                                    Text="🗑 Delete"
                                    BackgroundColor="#DC2626"
                                    TextColor="White"
                                    HeightRequest="45"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    Clicked="Delete_Clicked"
                                    CommandParameter="{Binding Id}"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center">

                    <Label
                        Text="💼"
                        FontSize="70"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="No Experience Added"
                        FontSize="22"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Tap + to add your first experience."
                        TextColor="Gray"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

        </CollectionView>

        <Button
            Text="+"
            WidthRequest="65"
            HeightRequest="65"
            CornerRadius="32"
            FontSize="30"
            BackgroundColor="#2563EB"
            TextColor="White"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="25"
            Clicked="AddExperience_Clicked"/>

    </Grid>

</ContentPage>
