<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CVPilot.Views.Sections.PersonalDetailsPage"
    Title="Personal Details"
    BackgroundColor="#F6F8FC">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="👤 Personal Details"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#1E3A8A"/>

            <Label
                Text="Complete your profile information"
                FontSize="15"
                TextColor="Gray"/>

            <Border
                Stroke="#D9D9D9"
                StrokeThickness="1"
                StrokeShape="RoundRectangle"
                Padding="15"
                BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <Entry x:Name="FullNameEntry"
                           Placeholder="Full Name"/>

                    <Entry x:Name="ProfessionalTitleEntry"
                           Placeholder="Professional Title"/>

                    <Entry x:Name="EmailEntry"
                           Placeholder="Email"
                           Keyboard="Email"/>

                    <Entry x:Name="PhoneEntry"
                           Placeholder="Phone Number"
                           Keyboard="Telephone"/>

                    <Entry x:Name="AlternatePhoneEntry"
                           Placeholder="Alternate Phone"
                           Keyboard="Telephone"/>

                    <Label
                           Text="Date of Birth"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Black"/>

                    <DatePicker x:Name="DobPicker"/>

                    <Picker x:Name="GenderPicker"
                            Title="Gender">
                        <Picker.Items>
                            <x:String>Male</x:String>
                            <x:String>Female</x:String>
                            <x:String>Other</x:String>
                        </Picker.Items>
                    </Picker>

                    <Entry x:Name="NationalityEntry"
                           Placeholder="Nationality"/>

                    <Editor x:Name="AddressEditor"
                            Placeholder="Address"
                            AutoSize="TextChanges"
                            HeightRequest="90"/>

                    <Entry x:Name="CityEntry"
                           Placeholder="City"/>

                    <Entry x:Name="StateEntry"
                           Placeholder="State"/>

                    <Entry x:Name="CountryEntry"
                           Placeholder="Country"/>

                    <Entry x:Name="PincodeEntry"
                           Placeholder="Pincode"
                           Keyboard="Numeric"/>

                    <Entry x:Name="LinkedInEntry"
                           Placeholder="LinkedIn Profile URL"/>

                    <Entry x:Name="GitHubEntry"
                           Placeholder="GitHub Profile URL"/>

                    <Entry x:Name="PortfolioEntry"
                           Placeholder="Portfolio Website"/>

                    <Editor x:Name="SummaryEditor"
                            Placeholder="Professional Summary"
                            AutoSize="TextChanges"
                            HeightRequest="140"/>

                </VerticalStackLayout>

            </Border>

            <Button
                Text="Save &amp; Continue"
                HeightRequest="55"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="15"
                Clicked="Save_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
